# ---------------------------------------------------------------------------
# Make My Home — environment configuration
# Copy this file to `.env.local` (or `.env`) and fill in real values.
# Never commit `.env`, `.env.local`, or any write token.
# ---------------------------------------------------------------------------

# Public site URL. Use the real HTTPS origin in production; canonical URLs,
# Open Graph URLs, JSON-LD, robots.txt and sitemap.xml are built from it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# PostgreSQL connection string. The app and Better Auth share this database.
# On Vercel with Supabase, use the transaction pooler URL (port 6543) with SSL.
DATABASE_URL=postgresql://user:password@localhost:5432/makemyhome_auth
# Prisma CLI schema commands use this session/direct URL (Supabase pooler port 5432).
DIRECT_URL=
# Optional override for the custom SQL migration runner.
DATABASE_MIGRATION_URL=
# Optional. Defaults to 1 on Vercel and 10 in persistent local/server hosting.
PG_POOL_MAX=

# --- Better Auth -----------------------------------------------------------
# Server-side base URL. Must match the public origin in production.
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional Better Auth infrastructure key. Leave blank if unused.
BETTER_AUTH_API_KEY=
# Optional. Only set this when the auth API is on a different origin than the
# storefront. By default the browser client uses window.location.origin.
NEXT_PUBLIC_BETTER_AUTH_URL=

# Comma-separated allowlist of admin emails. Admin access fails closed when
# this is empty. Public sign-up is disabled unless explicitly enabled below.
ADMIN_EMAILS=
# The account owner; reserve payment, access and destructive CRM controls for this email.
MAIN_ADMIN_EMAIL=
ALLOW_PUBLIC_SIGNUP=false

# Optional local-only catalogue demo. Production builds never use demo content.
ALLOW_DEMO_DATA=false

# --- Online payments (YOUPI-PG) --------------------------------------------
# Online payment is offered only for an approved quotation. The customer pays by
# UPI, submits the UPI reference, and an admin confirms the money in the
# receiving bank account before the quotation is marked paid.
#
# Set PAYMENTS_ENABLED=false to hide the checkout; the quote page then shows the
# call/WhatsApp fallback instead.
PAYMENTS_ENABLED=true

# Base URL of the YOUPI checkout portal. Locally this is the checkout service
# started by `npm run dev` inside youpi-pg. In production use the public HTTPS
# origin of the gateway.
YOUPI_API_URL=http://localhost:7000

# Merchant UUID and server-only API key from the YOUPI merchant admin. The API
# key must never be exposed to the browser.
YOUPI_MERCHANT_ID=
YOUPI_MERCHANT_API_KEY=

# Shared secret for the signed webhook at /api/webhooks/youpi. This is a
# different secret from the merchant API key.
YOUPI_WEBHOOK_SECRET=

# MANUAL_UPI keeps the shop in control of the bank verification. Changing this
# changes the quote payment flow and requires code changes in src/lib/youpi.ts.
YOUPI_METHOD=MANUAL_UPI

# How long to wait for the gateway before showing a retry message.
YOUPI_REQUEST_TIMEOUT_MS=15000

# --- Sanity (required for the catalogue) ----------------------------------
# Create a project at https://sanity.io/manage and paste its details here.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional. Only needed for a private dataset or draft/preview reads.
# This token must never be prefixed with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Required only by the import and demo-seed scripts when writing content, not
# by the running website. Sanity Studio editors sign in with their own Sanity
# account. Create a token with Editor permissions in the Sanity project.
# Keep it server-side. Never expose it in the browser.
SANITY_API_WRITE_TOKEN=

# Shared secret for the Sanity webhook at /api/revalidate.
# Configure the same value in the Sanity webhook settings.
# See SANITY_CMS.md for the CORS and webhook setup.
SANITY_REVALIDATE_SECRET=

# --- WhatsApp --------------------------------------------------------------
# The business WhatsApp number is managed in Sanity Studio → Site settings.
# There is no environment-variable fallback: missing Site Settings produces
# honest empty states instead of a broken or invented number.

# --- Analytics (optional) --------------------------------------------------
NEXT_PUBLIC_GA_ID=
