# ---------------------------------------------------------------------------
# Make My Home — environment configuration
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` or any write token.
# ---------------------------------------------------------------------------

# Public site URL (used for metadata and canonical URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity (required for the catalogue) ----------------------------------
# Create a project at https://sanity.io/manage and paste its details here.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional. Only needed for a private dataset or draft/preview reads.
# This token must never be prefixed with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Required only by the import scripts (scripts/import-products.ts).
# Create a token with Editor permissions in the Sanity project.
# Keep it server-side. Never expose it in the browser.
SANITY_API_WRITE_TOKEN=

# Shared secret for the optional Sanity webhook at /api/revalidate.
# Configure the same value in the Sanity webhook settings.
SANITY_REVALIDATE_SECRET=

# --- Clerk (optional customer accounts) -----------------------------------
# Leave blank to run the storefront without customer sign-in.
# Clerk editor access is completely separate from Sanity editor access.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- WhatsApp --------------------------------------------------------------
# The business WhatsApp number is managed in Sanity Studio → Site settings.
# Do not put an invented number here. This env value is only a fallback.
# Include the country code, digits only (e.g. 919876543210).
NEXT_PUBLIC_WHATSAPP_NUMBER=
