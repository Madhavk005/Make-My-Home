// Prisma models mirror database/migrations. Keep the SQL migration runner as the
// source of schema changes until an explicit Prisma migration baseline exists.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String     @db.VarChar(120)
  phone     String     @unique @db.VarChar(20)
  location  String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  enquiries Enquiry[]

  @@map("customers")
}

model Enquiry {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference        String        @unique @default(dbgenerated()) @db.VarChar(40)
  customerId       String?       @map("customer_id") @db.Uuid
  customerName     String        @map("customer_name") @db.VarChar(120)
  customerPhone    String        @map("customer_phone") @db.VarChar(20)
  customerLocation String?       @map("customer_location")
  customerNote     String?       @map("customer_note")
  language         String        @default("hi") @db.VarChar(5)
  status           String        @default("new") @db.VarChar(20)
  source           String        @default("whatsapp_click") @db.VarChar(30)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  adminNotes       String?       @map("admin_notes")
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items            EnquiryItem[]

  @@index([createdAt(sort: Desc)], map: "idx_enquiries_created_at")
  @@index([status], map: "idx_enquiries_status")
  @@map("enquiries")
}

model EnquiryItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enquiryId    String   @map("enquiry_id") @db.Uuid
  productId    String?  @map("product_id")
  productSlug  String?  @map("product_slug")
  productName  String   @map("product_name")
  brand        String?
  sku          String?
  variantLabel String?  @map("variant_label")
  attributes   Json     @default("{}") @db.JsonB
  price        Decimal? @db.Decimal(12, 2)
  priceStatus  String?  @map("price_status")
  availability String?
  quantity     Decimal  @db.Decimal(12, 3)
  unit         String   @default("piece")
  notes        String?
  imageUrl     String?  @map("image_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  enquiry      Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId], map: "idx_enquiry_items_enquiry_id")
  @@index([productId], map: "idx_enquiry_items_product_id")
  @@map("enquiry_items")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorEmail String?  @map("actor_email")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "idx_audit_logs_created_at")
  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@map("audit_logs")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @db.Timestamptz(6)
  sessions      Session[]
  accounts      Account[]

  @@unique([email], map: "user_email_key")
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(6)
  token     String   @unique(map: "session_token_key")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @db.Timestamptz(6)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}
